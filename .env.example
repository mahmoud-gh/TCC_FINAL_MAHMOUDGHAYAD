# ============================================================================
#  CRM WhatsApp — API OFICIAL da Meta (WhatsApp Business Cloud API)
#  Copie este arquivo para ".env" e preencha.
# ============================================================================

# ----------------------------------------------------------------------------
# Servidor
# ----------------------------------------------------------------------------
PORT=3000
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=troque-por-uma-string-aleatoria-longa

# Endereço público (túnel do Cloudflare). Usado no webhook da Meta e nos links
# rastreados das campanhas. Sem isso o link sai como localhost e os cliques não contam.
PUBLIC_BASE_URL=https://crm.seudominio.com.br

# ----------------------------------------------------------------------------
# Meta — developers.facebook.com → seu App → WhatsApp → Configuração da API
# ----------------------------------------------------------------------------
META_APP_ID=
# Configurações do app → Básico → Chave secreta do app (valida a assinatura do webhook)
META_APP_SECRET=
# Qualquer texto. O mesmo vai no campo "Verificar token" do webhook no painel da Meta.
META_VERIFY_TOKEN=escolha-um-texto-qualquer
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
# Use um token PERMANENTE de Usuário do Sistema (o token temporário expira em 24 h).
# Sem token, os envios são apenas simulados no terminal (modo dev).
WHATSAPP_ACCESS_TOKEN=
# Versão da Graph API (a v20.0 foi desativada pela Meta em 09/2026)
GRAPH_API_VERSION=v25.0

# Instagram (opcional — mesma conta Meta, via Página do Facebook)
INSTAGRAM_PAGE_ID=
INSTAGRAM_PAGE_ACCESS_TOKEN=

# ----------------------------------------------------------------------------
# Chatbot (consulta de estoque com a loja fechada)
# ----------------------------------------------------------------------------
CHATBOT_ENABLED=true
STORE_NAME=Digital Center
CHATBOT_PRECO=varejo
CHATBOT_MOEDA=USD
CHATBOT_MOSTRAR_QUANTIDADE=false
CHATBOT_PAUSA_HUMANO_HORAS=12
CHATBOT_LIMITE_DIARIO=20
# IA (console.anthropic.com). Sem chave, o bot responde com busca direta no catálogo.
CHATBOT_IA=true
ANTHROPIC_API_KEY=
# Só para chaves novas (sk-ant-usr-/sk-ant-svc-) que pedem o workspace
ANTHROPIC_WORKSPACE_ID=
ANTHROPIC_MODEL=claude-haiku-5-5
# Catálogo de produtos (feed XML)
CATALOGO_XML_URL=https://digitalcenterpy.com/xml.xml

# Horário da loja (fora dele o chatbot atende). Dias: 1=seg ... 7=dom
BUSINESS_HOURS_START=07:00
BUSINESS_HOURS_END=15:30
BUSINESS_DAYS=1,2,3,4,5
BUSINESS_TIMEZONE=America/Asuncion

# ----------------------------------------------------------------------------
# Campanhas
# ----------------------------------------------------------------------------
# O próprio sistema dispara as campanhas agendadas (verifica a cada minuto).
CAMPAIGN_SCHEDULER_ENABLED=true
CAMPAIGN_SCHEDULER_INTERVAL_MS=60000
CAMPAIGN_SEND_DELAY_MS=350
ATTRIBUTION_WINDOW_HOURS=72
OPTOUT_KEYWORDS=sair,parar,cancelar,descadastrar,stop,remover

# ----------------------------------------------------------------------------
# Banco de dados — PostgreSQL 16
# ----------------------------------------------------------------------------
PGHOST=localhost
PGPORT=5432
PGUSER=crm
PGPASSWORD=troque-esta-senha
PGDATABASE=crm
# Alternativa a tudo acima:
# DATABASE_URL=postgresql://crm:senha@localhost:5432/crm
